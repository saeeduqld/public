# Copy this file to .env for LOCAL testing only. NEVER upload .env to GitHub.
# The real API key is private. Set it in Render > Environment for hosting.
OPENROUTER_API_KEY=PUT_YOUR_PRIVATE_KEY_HERE
# Same model is enforced for both chatbot conditions.
OPENROUTER_MODEL=openai/gpt-4.1-mini
# This separate pilot code is safe to share with your coauthors, not publicly.
APP_ACCESS_CODE=REPLACE_WITH_A_LONG_RANDOM_PILOT_CODE
# Lightweight per-IP abuse protection; also set a strict OpenRouter key spending cap.
MAX_REQUESTS_PER_IP_PER_HOUR=60